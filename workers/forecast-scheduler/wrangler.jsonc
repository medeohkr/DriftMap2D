{
  "name": "driftmap-forecast-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17,47 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GITHUB_OWNER": "medeohkr",
    "GITHUB_REPO": "DriftMap2D",
    "GITHUB_REF": "main"
  }
}
